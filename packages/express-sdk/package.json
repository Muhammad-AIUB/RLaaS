      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "dependencies": {
    "@rlaas/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.5"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean"
  }
}
