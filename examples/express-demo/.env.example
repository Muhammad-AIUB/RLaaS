PORT=4000
RLAAS_GATEWAY_URL=http://localhost:3000/api/gateway/check
# Required, no default. Issue one from the dashboard: Projects -> API Keys.
# The value that used to sit here was committed to this public repository and
# is burned — do not reuse it.
RLAAS_API_KEY=
# Proxies in front of this app. 0 = trust nothing, use the socket address.
TRUST_PROXY_HOPS=0
