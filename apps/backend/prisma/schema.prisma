generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  FREE
  PRO
  BUSINESS
  ENTERPRISE
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum ProjectRole {
  OWNER
  ADMIN
  VIEWER
}

enum RuleScope {
  IP
  API_KEY
  USER_TIER
  ENDPOINT
  GLOBAL
}

enum RuleAlgorithm {
  FIXED_WINDOW
  SLIDING_WINDOW_LOG
  SLIDING_WINDOW_COUNTER
  TOKEN_BUCKET
}

enum RequestDecision {
  ALLOWED
  BLOCKED
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
  OPTIONS
  HEAD
}

enum SnapshotWindow {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
}

enum WebhookEventType {
  HIGH_BLOCKED_ACTIVITY
}

model User {
  id               String          @id @default(uuid()) @db.Uuid
  email            String          @unique @db.VarChar(255)
  passwordHash     String          @map("password_hash") @db.VarChar(255)
  fullName         String          @map("full_name") @db.VarChar(120)
  tier             UserTier        @default(FREE)
  isActive         Boolean         @default(true) @map("is_active")
  projects         Project[]
  projectMembers   ProjectMember[]
  auditLogs        AuditLog[]
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@map("users")
}

model Project {
  id               String              @id @default(uuid()) @db.Uuid
  ownerId          String              @map("owner_id") @db.Uuid
  name             String              @db.VarChar(120)
  slug             String              @unique @db.VarChar(120)
  description      String?             @db.Text
  environment      String              @default("production") @db.VarChar(50)
  isActive         Boolean             @default(true) @map("is_active")
  owner            User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  apiKeys          ApiKey[]
  members          ProjectMember[]
  rules            RateLimitRule[]
  requestLogs      RequestLog[]
  analytics        AnalyticsSnapshot[]
  auditLogs        AuditLog[]
  webhookEndpoints WebhookEndpoint[]
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("projects")
}

model ApiKey {
  id           String       @id @default(uuid()) @db.Uuid
  projectId    String       @map("project_id") @db.Uuid
  name         String       @db.VarChar(120)
  keyPrefix    String       @map("key_prefix") @db.VarChar(24)
  hashedKey    String       @map("hashed_key") @unique @db.VarChar(255)
  hashVersion  String       @default("hmac-sha256-v1") @map("hash_version") @db.VarChar(32)
  status       ApiKeyStatus @default(ACTIVE)
  lastUsedAt   DateTime?    @map("last_used_at")
  expiresAt    DateTime?    @map("expires_at")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestLogs  RequestLog[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([status])
  @@map("api_keys")
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId, role])
  @@map("project_members")
}

model RateLimitRule {
  id              String       @id @default(uuid()) @db.Uuid
  projectId       String       @map("project_id") @db.Uuid
  name            String       @db.VarChar(120)
  description     String?      @db.Text
  priority        Int
  scope           RuleScope
  targetValue     String?      @map("target_value") @db.VarChar(255)
  endpointPattern String?      @map("endpoint_pattern") @db.VarChar(255)
  method          HttpMethod?
  userTier        UserTier?    @map("user_tier")
  algorithm       RuleAlgorithm
  limit           Int
  windowSeconds   Int          @map("window_seconds")
  burstCapacity   Int?         @map("burst_capacity")
  isActive        Boolean      @default(true) @map("is_active")
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestLogs     RequestLog[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@index([projectId, isActive])
  @@index([projectId, priority])
  @@index([scope, targetValue])
  @@map("rate_limit_rules")
}

model RequestLog {
  id             String          @id @default(uuid()) @db.Uuid
  projectId      String          @map("project_id") @db.Uuid
  apiKeyId       String?         @map("api_key_id") @db.Uuid
  ruleId         String?         @map("rule_id") @db.Uuid
  requestId      String?         @map("request_id") @db.VarChar(120)
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(120)
  ipAddress      String          @map("ip_address") @db.VarChar(64)
  endpoint       String          @db.VarChar(255)
  method         HttpMethod
  userTier       UserTier?       @map("user_tier")
  decision       RequestDecision
  reason         String?         @db.VarChar(120)
  algorithm      RuleAlgorithm
  limit          Int
  remaining      Int
  retryAfter     Int             @default(0) @map("retry_after")
  responseTimeMs Int?            @map("response_time_ms")
  metadata       Json?
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  rule           RateLimitRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "request_logs_project_recent_idx")
  @@index([apiKeyId, createdAt])
  @@index([decision, createdAt])
  @@index([ipAddress, createdAt])
  @@index([endpoint, method])
  @@index([projectId, idempotencyKey])
  @@map("request_logs")
}

model AnalyticsSnapshot {
  id                             String         @id @default(uuid()) @db.Uuid
  projectId                      String         @map("project_id") @db.Uuid
  window                         SnapshotWindow
  periodStart                    DateTime       @map("period_start")
  periodEnd                      DateTime       @map("period_end")
  totalRequests                  Int            @default(0) @map("total_requests")
  allowedRequests                Int            @default(0) @map("allowed_requests")
  blockedRequests                Int            @default(0) @map("blocked_requests")
  blockRate                      Decimal        @default(0) @map("block_rate") @db.Decimal(5, 2)
  topOffendingIps                Json?          @map("top_offending_ips")
  mostUsedEndpoints              Json?          @map("most_used_endpoints")
  algorithmPerformanceComparison Json?          @map("algorithm_performance_comparison")
  project                        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt                      DateTime       @default(now()) @map("created_at")
  updatedAt                      DateTime       @updatedAt @map("updated_at")

  @@unique([projectId, window, periodStart, periodEnd])
  @@index([projectId, periodStart, periodEnd])
  @@map("analytics_snapshots")
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorId      String?   @map("actor_id") @db.Uuid
  projectId    String?   @map("project_id") @db.Uuid
  action       String    @db.VarChar(120)
  resourceType String    @map("resource_type") @db.VarChar(80)
  resourceId   String?   @map("resource_id") @db.VarChar(120)
  ipAddress    String?   @map("ip_address") @db.VarChar(64)
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  metadata     Json?
  actor        User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model WebhookEndpoint {
  id                      String           @id @default(uuid()) @db.Uuid
  projectId               String           @map("project_id") @db.Uuid
  name                    String           @db.VarChar(120)
  url                     String           @db.VarChar(2048)
  signingSecret           String?          @map("signing_secret") @db.VarChar(255)
  eventType               WebhookEventType @map("event_type")
  blockedRequestsThreshold Int             @default(25) @map("blocked_requests_threshold")
  windowSeconds           Int              @default(300) @map("window_seconds")
  cooldownSeconds         Int              @default(300) @map("cooldown_seconds")
  isActive                Boolean          @default(true) @map("is_active")
  lastTriggeredAt         DateTime?        @map("last_triggered_at")
  project                 Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")

  @@index([projectId, eventType, isActive])
  @@map("webhook_endpoints")
}
