PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rlaas?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required. The app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Required. Changing it invalidates every existing API key.
API_KEY_HASH_PEPPER=replace-with-a-different-long-random-secret
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_ALGORITHM=fixed_window
IDEMPOTENCY_TTL_SECONDS=300
PRISMA_QUERY_DEBUG=false
# Local only: writes the password-reset code to the server log (there is no
# email transport). Ignored when NODE_ENV=production.
AUTH_LOG_RESET_CODE=false
SEED_DEMO_EMAIL=demo@rlaas.local
SEED_DEMO_PASSWORD=DemoPass123!
SEED_DEMO_FULL_NAME=RLaaS Demo User
SEED_RAW_API_KEY=rlaas_live_demo_seed_key_1234567890
