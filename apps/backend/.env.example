PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/rlaas?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Required. The app refuses to start without it.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
# Required. Changing it invalidates every existing API key.
API_KEY_HASH_PEPPER=replace-with-a-different-long-random-secret
RATE_LIMIT_DEFAULT_LIMIT=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_DEFAULT_ALGORITHM=fixed_window
IDEMPOTENCY_TTL_SECONDS=300
# How many proxies sit in front of this app. 0 (the default) ignores
# x-forwarded-for and uses the socket address; set 1 behind a single load
# balancer or CDN. Too low over-limits clients together; too high lets a caller
# pick its own IP and walk past IP-scoped rules. When unsure, leave it at 0.
TRUSTED_PROXY_HOPS=0
PRISMA_QUERY_DEBUG=false
# Local only: writes the password-reset code to the server log (there is no
# email transport). Ignored when NODE_ENV=production.
AUTH_LOG_RESET_CODE=false
# Optional demo seed, for a throwaway local database only. The seed skips the
# user without SEED_DEMO_PASSWORD and skips the API key without SEED_RAW_API_KEY.
#
# The values that used to sit here (DemoPass123! and
# rlaas_live_demo_seed_key_1234567890) were committed to this public repository
# and are permanently readable in git history. They are burned. Generate your
# own and never point them at anything that matters:
#   openssl rand -base64 24
SEED_DEMO_EMAIL=demo@rlaas.local
SEED_DEMO_PASSWORD=
SEED_DEMO_FULL_NAME=RLaaS Demo User
SEED_RAW_API_KEY=
