{
  "name": "rlaas-platform",
  "version": "0.1.0",
  "private": true,
  "description": "RLaaS Platform monorepo",
  "scripts": {
    "dev:backend": "pnpm --filter @rlaas/backend-api start:dev",
    "dev:frontend": "pnpm --filter @rlaas/frontend-dashboard dev",
    "dev:sdk-demo": "pnpm --filter @rlaas/express-sdk-demo dev",
    "build:backend": "pnpm --filter @rlaas/backend-api build",
    "build:frontend": "pnpm --filter @rlaas/frontend-dashboard build",
    "build:shared": "pnpm --filter @rlaas/shared build",
    "build:sdk": "pnpm --filter @rlaas/sdk build",
    "build:sdk-demo": "pnpm --filter @rlaas/express-sdk-demo build",
    "loadtest:gateway": "k6 run load-tests/gateway-check.k6.js",
    "benchmark:algorithms": "tsx benchmarks/algorithm-benchmark.ts",
    "test:backend": "pnpm --filter @rlaas/backend-api test"
  },
  "packageManager": "pnpm@10.33.2",
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.20.6"
  }
}
